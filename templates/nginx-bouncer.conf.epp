<%- |
  String                          $api_url,
  Optional[String]                $api_key,
  Enum['stream', 'live']          $mode,
  Enum['all', 'ban', 'captcha']   $bouncing_on_type,
  Optional[String]                $appsec_url,
  Enum['passthrough', 'deny']     $appsec_failure_action,
  Integer[1]                      $request_timeout,
  Optional[Integer[1]]            $update_frequency,
  Optional[String]                $captcha_provider,
  Optional[String]                $captcha_site_key,
  Optional[String]                $captcha_secret_key,
  Optional[String]                $ban_template_path,
  Optional[String]                $redirect_location,
| -%>
# #####################################################################
# ACHTUNG: Diese Datei wird von Puppet verwaltet!
# Manuelle Aenderungen werden beim naechsten Puppet-Lauf ueberschrieben.
# Aenderungen bitte im Puppet-Modul 'crowdsec' vornehmen.
#
# WARNING: This file is managed by Puppet.
# DO NOT EDIT manually - changes will be overwritten on the next Puppet run.
# #####################################################################
API_URL=<%= $api_url %>
<% if $api_key { -%>
API_KEY=<%= $api_key %>
<% } -%>
MODE=<%= $mode %>
BOUNCING_ON_TYPE=<%= $bouncing_on_type %>
FALLBACK_REMEDIATION=ban
REQUEST_TIMEOUT=<%= $request_timeout %>
<% if $update_frequency { -%>
UPDATE_FREQUENCY=<%= $update_frequency %>
<% } -%>
<% if $appsec_url { -%>
APPSEC_URL=<%= $appsec_url %>
APPSEC_FAILURE_ACTION=<%= $appsec_failure_action %>
ALWAYS_SEND_TO_APPSEC=false
<% } -%>
CAPTCHA_PROVIDER=<%= $captcha_provider %>
SITE_KEY=<%= $captcha_site_key %>
SECRET_KEY=<%= $captcha_secret_key %>
<% if $ban_template_path { -%>
BAN_TEMPLATE_PATH=<%= $ban_template_path %>
<% } -%>
<% if $redirect_location { -%>
REDIRECT_LOCATION=<%= $redirect_location %>
<% } -%>
