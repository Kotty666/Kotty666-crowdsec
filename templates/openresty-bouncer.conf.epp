<%- |
  Boolean                       $enabled,
  String                        $api_url,
  Optional[String]              $api_key,
  Enum['stream', 'live']        $mode,
  Integer                       $cache_expiration,
  Integer                       $request_timeout,
  Integer                       $update_frequency,
  Boolean                       $enable_internal,
  Boolean                       $ssl_verify,
  Enum['all', 'ban', 'captcha'] $bouncing_on_type,
  Enum['ban', 'captcha']        $fallback_remediation,
  Optional[String]              $exclude_location,
  String                        $ban_template_path,
  Optional[String]              $redirect_location,
  Optional[Integer]             $ret_code,
  Optional[String]              $captcha_provider,
  Optional[String]              $captcha_secret_key,
  Optional[String]              $captcha_site_key,
  String                        $captcha_template_path,
  Integer                       $captcha_expiration,
  Optional[String]              $appsec_url,
  Enum['passthrough', 'deny']   $appsec_failure_action,
  Optional[Integer]             $appsec_connect_timeout,
  Optional[Integer]             $appsec_send_timeout,
  Optional[Integer]             $appsec_process_timeout,
  Boolean                       $always_send_to_appsec,
  Hash[String, String]          $extra_config,
| -%>
# #####################################################################
# ACHTUNG: Diese Datei wird von Puppet verwaltet!
# Manuelle Aenderungen werden beim naechsten Puppet-Lauf ueberschrieben.
# Aenderungen bitte im Puppet-Modul 'crowdsec' vornehmen.
#
# WARNING: This file is managed by Puppet.
# DO NOT EDIT manually - changes will be overwritten on the next Puppet run.
# #####################################################################
ENABLED=<%= $enabled %>
API_URL=<%= $api_url %>
<% if $api_key { -%>
API_KEY=<%= $api_key %>
<% } -%>
CACHE_EXPIRATION=<%= $cache_expiration %>
BOUNCING_ON_TYPE=<%= $bouncing_on_type %>
FALLBACK_REMEDIATION=<%= $fallback_remediation %>
REQUEST_TIMEOUT=<%= $request_timeout %>
UPDATE_FREQUENCY=<%= $update_frequency %>
ENABLE_INTERNAL=<%= $enable_internal %>
MODE=<%= $mode %>
EXCLUDE_LOCATION=<%= $exclude_location %>
BAN_TEMPLATE_PATH=<%= $ban_template_path %>
REDIRECT_LOCATION=<%= $redirect_location %>
RET_CODE=<%= $ret_code %>
CAPTCHA_PROVIDER=<%= $captcha_provider %>
SECRET_KEY=<%= $captcha_secret_key %>
SITE_KEY=<%= $captcha_site_key %>
CAPTCHA_TEMPLATE_PATH=<%= $captcha_template_path %>
CAPTCHA_EXPIRATION=<%= $captcha_expiration %>
<% if $appsec_url { -%>
APPSEC_URL=<%= $appsec_url %>
<% } else { -%>
APPSEC_URL=
<% } -%>
APPSEC_FAILURE_ACTION=<%= $appsec_failure_action %>
APPSEC_CONNECT_TIMEOUT=<%= $appsec_connect_timeout %>
APPSEC_SEND_TIMEOUT=<%= $appsec_send_timeout %>
APPSEC_PROCESS_TIMEOUT=<%= $appsec_process_timeout %>
ALWAYS_SEND_TO_APPSEC=<%= $always_send_to_appsec %>
SSL_VERIFY=<%= $ssl_verify %>
<% $extra_config.each |String $key, String $value| { -%>
<%= $key %>=<%= $value %>
<% } -%>
